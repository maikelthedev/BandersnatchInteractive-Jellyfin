<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Jellyfin.Plugin.InteractiveVideo</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.InteractiveVideo</RootNamespace>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Version>1.2.0.0</Version>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CA1031;CA1062;CA1305;CA1307;CA1310;CA1724;CA1805;CA1848;CA2007;CS1591</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Plugin.cs" />
    <Compile Include="PluginConfiguration.cs" />
    <Compile Include="Api/InteractiveVideoController.cs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Two ways to bind to Jellyfin.
       * JellyfinDir=PATH  -> reference the assemblies of the server that is
         actually running (build.sh discovers it), so the plugin always matches
         that server's ABI.
       * otherwise (CI, plain `dotnet build`) -> the published SDK packages.
         A plugin built against these still loads on newer servers, because
         .NET resolves the reference by simple name against the loaded
         MediaBrowser assemblies. -->
  <ItemGroup Condition="'$(JellyfinDir)' != ''">
    <Reference Include="MediaBrowser.Common">
      <HintPath>$(JellyfinDir)/MediaBrowser.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Model">
      <HintPath>$(JellyfinDir)/MediaBrowser.Model.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Controller">
      <HintPath>$(JellyfinDir)/MediaBrowser.Controller.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(JellyfinDir)' == ''">
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web/**/*" />
    <EmbeddedResource Include="Configuration/configPage.html" />
  </ItemGroup>

</Project>
